      <description>Employee details and proposed start date.</description>
    </processDataItem>
    <processDataItem>
      <dataItemId>hrData</dataItemId>
      <processId>onboarding</processId>
      <name>HR record</name>
      <description>Prepared employee record.</description>
    </processDataItem>
    <processDataItem>
      <dataItemId>accountData</dataItemId>
      <processId>onboarding</processId>
      <name>Account record</name>
      <description>Provisioned account details.</description>
    </processDataItem>
    <processDataItem>
      <dataItemId>equipmentData</dataItemId>
      <processId>onboarding</processId>
      <name>Equipment record</name>
      <description>Equipment allocation details.</description>
    </processDataItem>
  </dataItems>
