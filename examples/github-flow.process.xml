      <isDefault>false</isDefault>
    </processRelationship>
    <processRelationship>
      <relationshipId>gf10</relationshipId>
      <relationshipType>SEQUENCE_FLOW</relationshipType>
      <sourceElementId>review</sourceElementId>
      <targetElementId>join</targetElementId>
      <name>Review completed</name>
      <isDefault>false</isDefault>
    </processRelationship>
    <processRelationship>
      <relationshipId>gf11</relationshipId>
      <relationshipType>SEQUENCE_FLOW</relationshipType>
      <sourceElementId>join</sourceElementId>
      <targetElementId>assess</targetElementId>
      <name></name>
      <isDefault>false</isDefault>
    </processRelationship>
    <processRelationship>
      <relationshipId>gf12</relationshipId>
      <relationshipType>SEQUENCE_FLOW</relationshipType>
      <sourceElementId>assess</sourceElementId>
      <targetElementId>decision</targetElementId>
      <name></name>
      <isDefault>false</isDefault>
    </processRelationship>
    <processRelationship>
      <relationshipId>gf13</relationshipId>
      <relationshipType>SEQUENCE_FLOW</relationshipType>
      <sourceElementId>decision</sourceElementId>
      <targetElementId>revise</targetElementId>
      <name>Revise</name>
      <conditionExpression>mergeDecision == 'revise'</conditionExpression>
      <isDefault>false</isDefault>
    </processRelationship>
    <processRelationship>
      <relationshipId>gf14</relationshipId>
      <relationshipType>SEQUENCE_FLOW</relationshipType>
      <sourceElementId>revise</sourceElementId>
      <targetElementId>fork</targetElementId>
      <name>Updated commits</name>
      <isDefault>false</isDefault>
    </processRelationship>
    <processRelationship>
      <relationshipId>gf15</relationshipId>
      <relationshipType>SEQUENCE_FLOW</relationshipType>
      <sourceElementId>decision</sourceElementId>
      <targetElementId>merge</targetElementId>
      <name>Ready to merge</name>
      <conditionExpression>mergeDecision == 'ready'</conditionExpression>
      <isDefault>false</isDefault>
    </processRelationship>
    <processRelationship>
      <relationshipId>gf16</relationshipId>
      <relationshipType>SEQUENCE_FLOW</relationshipType>
      <sourceElementId>merge</sourceElementId>
      <targetElementId>cleanup</targetElementId>
