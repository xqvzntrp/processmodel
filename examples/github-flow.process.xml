<?xml version="1.0" encoding="UTF-8"?><processModel xmlns="urn:local.dev:processmodel:1" version="1">
  <processes>
    <processDefinition>
      <processId>githubFlow</processId>
      <name>Software change: proposal to merge</name>
      <description>Adapted from GitHub Flow. Review and checks are coordinated for the latest commits; merge, revise or close after assessment.</description>
    </processDefinition>
  </processes>
  <elements>
    <processElement>
      <elementId>proposed</elementId>
      <processId>githubFlow</processId>
      <elementType>START_EVENT</elementType>
      <name>Change proposed</name>
      <description>A proposed software change is available.</description>
    </processElement>
    <processElement>
      <elementId>describe</elementId>
      <processId>githubFlow</processId>
      <elementType>USER_TASK</elementType>
      <name>Describe the change</name>
      <description>Record its purpose, scope and acceptance criteria.</description>
    </processElement>
    <processElement>
      <elementId>branch</elementId>
      <processId>githubFlow</processId>
      <elementType>USER_TASK</elementType>
      <name>Create a branch</name>
      <description>Choose a branch for this change.</description>
    </processElement>
    <processElement>
      <elementId>implement</elementId>
      <processId>githubFlow</processId>
      <elementType>USER_TASK</elementType>
      <name>Implement the change</name>
      <description>Prepare the change and its tests.</description>
    </processElement>
    <processElement>
      <elementId>publish</elementId>
      <processId>githubFlow</processId>
      <elementType>USER_TASK</elementType>
      <name>Commit &amp; push changes</name>
      <description>Describe publication of the proposed commits; no push is performed by this model.</description>
    </processElement>
    <processElement>
      <elementId>openPr</elementId>
      <processId>githubFlow</processId>
      <elementType>USER_TASK</elementType>
      <name>Open a pull request</name>
      <description>Explain the change and request feedback.</description>
    </processElement>
    <processElement>
      <elementId>fork</elementId>
      <processId>githubFlow</processId>
      <elementType>PARALLEL_GATEWAY</elementType>
      <name>Begin checks and review</name>
      <description>Our adaptation allows both branches to proceed in parallel.</description>
    </processElement>
    <processElement>
      <elementId>checks</elementId>
      <processId>githubFlow</processId>
      <elementType>SERVICE_TASK</elementType>
      <name>Run automated checks</name>
      <description>Record a completed result, including failure; checks must finish for this revision.</description>
    </processElement>
    <processElement>
      <elementId>review</elementId>
      <processId>githubFlow</processId>
      <elementType>USER_TASK</elementType>
      <name>Review the change</name>
      <description>Record approval, requested changes or other feedback for this revision.</description>
    </processElement>
    <processElement>
      <elementId>join</elementId>
      <processId>githubFlow</processId>
      <elementType>PARALLEL_GATEWAY</elementType>
      <name>Collect both results</name>
      <description>Our adaptation waits for both review and checks, even if one reports a problem.</description>
    </processElement>
    <processElement>
      <elementId>assess</elementId>
      <processId>githubFlow</processId>
      <elementType>USER_TASK</elementType>
      <name>Assess merge readiness</name>
      <description>Consider both results, conflicts, repository rules and whether to continue.</description>
    </processElement>
    <processElement>
      <elementId>decision</elementId>
      <processId>githubFlow</processId>
      <elementType>EXCLUSIVE_GATEWAY</elementType>
      <name>Next action</name>
      <description>Select exactly one descriptive outcome: ready, revise or close.</description>
    </processElement>
    <processElement>
      <elementId>revise</elementId>
      <processId>githubFlow</processId>
      <elementType>USER_TASK</elementType>
      <name>Revise, commit &amp; push</name>
      <description>Address feedback, failed checks or conflicts; repeat review and checks for the updated commits.</description>
    </processElement>
    <processElement>
      <elementId>merge</elementId>
      <processId>githubFlow</processId>
      <elementType>USER_TASK</elementType>
      <name>Merge the pull request</name>
      <description>Describe the authorized merge; no repository changes are made by this model.</description>
    </processElement>
    <processElement>
      <elementId>cleanup</elementId>
      <processId>githubFlow</processId>
      <elementType>USER_TASK</elementType>
      <name>Delete the completed branch</name>
      <description>Describe post-merge cleanup; this application deletes no branches.</description>
    </processElement>
    <processElement>
      <elementId>merged</elementId>
      <processId>githubFlow</processId>
      <elementType>END_EVENT</elementType>
      <name>Change merged</name>
      <description>The change is integrated and branch cleanup is complete.</description>
    </processElement>
    <processElement>
      <elementId>closePr</elementId>
      <processId>githubFlow</processId>
      <elementType>USER_TASK</elementType>
      <name>Close without merging</name>
      <description>Our adaptation records the decision to stop pursuing the change.</description>
    </processElement>
    <processElement>
      <elementId>closed</elementId>
      <processId>githubFlow</processId>
      <elementType>END_EVENT</elementType>
      <name>Change closed without merge</name>
      <description>The proposed change is not integrated.</description>
    </processElement>
  </elements>
