    </processRelationship>
    <processRelationship>
      <relationshipId>flow21</relationshipId>
      <relationshipType>SEQUENCE_FLOW</relationshipType>
      <sourceElementId>decision</sourceElementId>
      <targetElementId>arrange</targetElementId>
      <name>Approved</name>
      <conditionExpression>managerDecision == 'approved'</conditionExpression>
      <isDefault>false</isDefault>
    </processRelationship>
    <processRelationship>
      <relationshipId>flow22</relationshipId>
      <relationshipType>SEQUENCE_FLOW</relationshipType>
      <sourceElementId>decision</sourceElementId>
      <targetElementId>revise</targetElementId>
      <name>Changes requested</name>
      <conditionExpression>managerDecision == 'revise'</conditionExpression>
      <isDefault>false</isDefault>
    </processRelationship>
    <processRelationship>
      <relationshipId>flow23</relationshipId>
      <relationshipType>SEQUENCE_FLOW</relationshipType>
      <sourceElementId>decision</sourceElementId>
      <targetElementId>notifyRejected</targetElementId>
      <name>Rejected</name>
      <conditionExpression>managerDecision == 'rejected'</conditionExpression>
      <isDefault>false</isDefault>
    </processRelationship>
    <processRelationship>
      <relationshipId>flow24</relationshipId>
      <relationshipType>SEQUENCE_FLOW</relationshipType>
      <sourceElementId>orderDecision</sourceElementId>
      <targetElementId>receivePay</targetElementId>
      <name>Order placed</name>
      <conditionExpression>orderingResult == 'placed'</conditionExpression>
      <isDefault>false</isDefault>
    </processRelationship>
    <processRelationship>
      <relationshipId>flow25</relationshipId>
      <relationshipType>SEQUENCE_FLOW</relationshipType>
      <sourceElementId>orderDecision</sourceElementId>
      <targetElementId>notifyRejected</targetElementId>
      <name>No budget</name>
      <conditionExpression>orderingResult == 'notPlaced'</conditionExpression>
      <isDefault>false</isDefault>
    </processRelationship>
    <processRelationship>
      <relationshipId>flow26</relationshipId>
      <relationshipType>SEQUENCE_FLOW</relationshipType>
      <sourceElementId>budgetDecision</sourceElementId>
      <targetElementId>placeOrder</targetElementId>
      <name>Available</name>
      <conditionExpression>budgetAvailable == true</conditionExpression>
      <isDefault>false</isDefault>
    </processRelationship>
    <processRelationship>
      <relationshipId>flow27</relationshipId>
      <relationshipType>SEQUENCE_FLOW</relationshipType>
      <sourceElementId>budgetDecision</sourceElementId>
      <targetElementId>recordNoOrder</targetElementId>
      <name>Unavailable</name>
      <conditionExpression>budgetAvailable == false</conditionExpression>
      <isDefault>false</isDefault>
    </processRelationship>
    <processRelationship>
      <relationshipId>flow28</relationshipId>
      <relationshipType>SEQUENCE_FLOW</relationshipType>
      <sourceElementId>deliveryDecision</sourceElementId>
      <targetElementId>recordReceipt</targetElementId>
      <name>Accepted</name>
      <conditionExpression>deliveryAccepted == true</conditionExpression>
      <isDefault>false</isDefault>
    </processRelationship>
    <processRelationship>
      <relationshipId>flow29</relationshipId>
      <relationshipType>SEQUENCE_FLOW</relationshipType>
      <sourceElementId>deliveryDecision</sourceElementId>
      <targetElementId>resolveDelivery</targetElementId>
      <name>Correction needed</name>
      <conditionExpression>deliveryAccepted == false</conditionExpression>
      <isDefault>false</isDefault>
    </processRelationship>
    <processRelationship>
      <relationshipId>flow30</relationshipId>
      <relationshipType>SEQUENCE_FLOW</relationshipType>
      <sourceElementId>invoiceDecision</sourceElementId>
      <targetElementId>authorizePayment</targetElementId>
      <name>Matched</name>
      <conditionExpression>invoiceMatched == true</conditionExpression>
      <isDefault>false</isDefault>
    </processRelationship>
    <processRelationship>
      <relationshipId>flow31</relationshipId>
      <relationshipType>SEQUENCE_FLOW</relationshipType>
      <sourceElementId>invoiceDecision</sourceElementId>
