<?xml version='1.0' encoding='utf-8'?>
<processModel xmlns="urn:local.dev:processmodel:1" version="1">
  <processes>
    <processDefinition>
      <processId>purchaseApproval</processId>
      <name>Purchase request through payment</name>
      <description>Illustrative purchase approval process: manager review, budget and ordering, then receipt and invoice checks before payment. Models one order, one complete delivery and one invoice. Partial deliveries, cancellation after ordering, returns and payment failures are outside this example; local approval rules remain open questions. This is a descriptive model, not an executable purchasing system.</description>
    </processDefinition>
  </processes>
  <elements>
    <processElement>
      <elementId>need</elementId>
      <processId>purchaseApproval</processId>
      <elementType>START_EVENT</elementType>
      <name>Purchase needed</name>
      <description>An employee identifies a business need.</description>
    </processElement>
    <processElement>
      <elementId>submit</elementId>
      <processId>purchaseApproval</processId>
      <elementType>USER_TASK</elementType>
      <name>Submit purchase request</name>
      <description>Describe the need, specification, estimated cost and cost center.</description>
    </processElement>
    <processElement>
      <elementId>review</elementId>
      <processId>purchaseApproval</processId>
      <elementType>USER_TASK</elementType>
      <name>Review purchase request</name>
      <description>Record exactly one decision: approve, request changes or reject. Reassess revised requests.</description>
    </processElement>
    <processElement>
      <elementId>decision</elementId>
      <processId>purchaseApproval</processId>
      <elementType>EXCLUSIVE_GATEWAY</elementType>
      <name>Manager decision</name>
      <description>Select the recorded manager decision.</description>
    </processElement>
    <processElement>
      <elementId>revise</elementId>
      <processId>purchaseApproval</processId>
      <elementType>USER_TASK</elementType>
      <name>Revise request</name>
      <description>Address review comments and resubmit the updated request.</description>
    </processElement>
    <processElement>
      <elementId>arrange</elementId>
      <processId>purchaseApproval</processId>
      <elementType>SUB_PROCESS</elementType>
      <name>Arrange purchase</name>
      <description>Check budget and place an approved order. Return an ordering result: placed or not placed.</description>
    </processElement>
    <processElement>
      <elementId>orderDecision</elementId>
      <processId>purchaseApproval</processId>
      <elementType>EXCLUSIVE_GATEWAY</elementType>
      <name>Order placed?</name>
      <description>Continue only if an order was placed; otherwise close with the recorded budget reason.</description>
    </processElement>
    <processElement>
      <elementId>receivePay</elementId>
      <processId>purchaseApproval</processId>
      <elementType>SUB_PROCESS</elementType>
      <name>Receive and pay</name>
      <description>Confirm complete delivery, resolve invoice differences and record authorized payment.</description>
    </processElement>
    <processElement>
      <elementId>close</elementId>
      <processId>purchaseApproval</processId>
      <elementType>USER_TASK</elementType>
      <name>Close completed request</name>
      <description>Confirm delivery and payment records are linked to the request.</description>
    </processElement>
    <processElement>
      <elementId>complete</elementId>
      <processId>purchaseApproval</processId>
      <elementType>END_EVENT</elementType>
      <name>Purchase completed</name>
      <description>The purchase has been received, payment recorded and request closed.</description>
    </processElement>
    <processElement>
      <elementId>notifyRejected</elementId>
      <processId>purchaseApproval</processId>
      <elementType>USER_TASK</elementType>
      <name>Notify employee of closure</name>
      <description>Record and communicate manager rejection or unavailable budget. No order has been placed on either closure path.</description>
    </processElement>
    <processElement>
      <elementId>rejected</elementId>
      <processId>purchaseApproval</processId>
      <elementType>END_EVENT</elementType>
      <name>Request closed without purchase</name>
      <description>The request is closed with the reason recorded.</description>
    </processElement>
    <processElement>
      <elementId>orderStart</elementId>
      <processId>purchaseApproval</processId>
      <elementType>START_EVENT</elementType>
      <name>Approved request received</name>
      <description>Begin arranging the approved purchase.</description>
      <parentSubprocessId>arrange</parentSubprocessId>
    </processElement>
    <processElement>
      <elementId>checkBudget</elementId>
      <processId>purchaseApproval</processId>
      <elementType>USER_TASK</elementType>
      <name>Check available budget</name>
      <description>Record whether sufficient budget is available for the approved request.</description>
      <parentSubprocessId>arrange</parentSubprocessId>
    </processElement>
    <processElement>
      <elementId>budgetDecision</elementId>
      <processId>purchaseApproval</processId>
      <elementType>EXCLUSIVE_GATEWAY</elementType>
      <name>Budget available?</name>
      <description>Select the recorded budget outcome.</description>
      <parentSubprocessId>arrange</parentSubprocessId>
    </processElement>
    <processElement>
      <elementId>placeOrder</elementId>
      <processId>purchaseApproval</processId>
      <elementType>USER_TASK</elementType>
      <name>Place purchase order</name>
      <description>Select the supplier, issue the order and record an ordering result of placed. This example assumes the supplier accepts the order.</description>
      <parentSubprocessId>arrange</parentSubprocessId>
    </processElement>
    <processElement>
      <elementId>recordNoOrder</elementId>
      <processId>purchaseApproval</processId>
      <elementType>USER_TASK</elementType>
      <name>Record unavailable budget</name>
      <description>Record an ordering result of not placed and the budget reason.</description>
      <parentSubprocessId>arrange</parentSubprocessId>
    </processElement>
    <processElement>
      <elementId>orderEnd</elementId>
      <processId>purchaseApproval</processId>
      <elementType>END_EVENT</elementType>
      <name>Ordering result available</name>
      <description>Return the ordering result and purchase order, if one was placed.</description>
      <parentSubprocessId>arrange</parentSubprocessId>
    </processElement>
    <processElement>
      <elementId>receiptStart</elementId>
      <processId>purchaseApproval</processId>
      <elementType>START_EVENT</elementType>
      <name>Order ready for receipt</name>
      <description>Begin fulfillment and settlement for the placed order.</description>
      <parentSubprocessId>receivePay</parentSubprocessId>
    </processElement>
    <processElement>
      <elementId>receiveGoods</elementId>
      <processId>purchaseApproval</processId>
      <elementType>USER_TASK</elementType>
      <name>Inspect delivery</name>
      <description>Record delivered items, quantities and condition.</description>
      <parentSubprocessId>receivePay</parentSubprocessId>
    </processElement>
    <processElement>
      <elementId>deliveryDecision</elementId>
      <processId>purchaseApproval</processId>
      <elementType>EXCLUSIVE_GATEWAY</elementType>
      <name>Delivery acceptable?</name>
      <description>Confirm that the complete delivery meets the order.</description>
      <parentSubprocessId>receivePay</parentSubprocessId>
    </processElement>
    <processElement>
      <elementId>resolveDelivery</elementId>
      <processId>purchaseApproval</processId>
      <elementType>USER_TASK</elementType>
      <name>Resolve delivery issue</name>
      <description>Arrange replacement or correction with the supplier, then inspect the corrected delivery. This example assumes eventual resolution.</description>
      <parentSubprocessId>receivePay</parentSubprocessId>
    </processElement>
    <processElement>
      <elementId>recordReceipt</elementId>
      <processId>purchaseApproval</processId>
      <elementType>USER_TASK</elementType>
      <name>Record accepted receipt</name>
      <description>Record acceptance of the complete delivery.</description>
      <parentSubprocessId>receivePay</parentSubprocessId>
    </processElement>
    <processElement>
      <elementId>matchInvoice</elementId>
      <processId>purchaseApproval</processId>
      <elementType>USER_TASK</elementType>
      <name>Match invoice to order and receipt</name>
      <description>Obtain the invoice and compare supplier, quantities and amounts with the order and accepted receipt.</description>
      <parentSubprocessId>receivePay</parentSubprocessId>
    </processElement>
    <processElement>
      <elementId>invoiceDecision</elementId>
      <processId>purchaseApproval</processId>
      <elementType>EXCLUSIVE_GATEWAY</elementType>
      <name>Invoice matches?</name>
      <description>Select the recorded invoice match outcome.</description>
      <parentSubprocessId>receivePay</parentSubprocessId>
    </processElement>
    <processElement>
      <elementId>resolveInvoice</elementId>
      <processId>purchaseApproval</processId>
      <elementType>USER_TASK</elementType>
      <name>Resolve invoice discrepancy</name>
      <description>Obtain a corrected invoice or resolve the discrepancy, then repeat matching.</description>
      <parentSubprocessId>receivePay</parentSubprocessId>
    </processElement>
    <processElement>
      <elementId>authorizePayment</elementId>
      <processId>purchaseApproval</processId>
      <elementType>USER_TASK</elementType>
      <name>Authorize payment</name>
      <description>Record authorization after invoice matching, using the organization approval policy.</description>
      <parentSubprocessId>receivePay</parentSubprocessId>
    </processElement>
    <processElement>
      <elementId>recordPayment</elementId>
      <processId>purchaseApproval</processId>
      <elementType>USER_TASK</elementType>
      <name>Record supplier payment</name>
      <description>Record the payment reference after payment through the organization payment system. Payment execution and failures are outside this model.</description>
      <parentSubprocessId>receivePay</parentSubprocessId>
    </processElement>
    <processElement>
      <elementId>receiptEnd</elementId>
      <processId>purchaseApproval</processId>
      <elementType>END_EVENT</elementType>
      <name>Receipt and payment complete</name>
      <description>Return accepted receipt, matched invoice, authorization and payment record.</description>
      <parentSubprocessId>receivePay</parentSubprocessId>
    </processElement>
  </elements>
